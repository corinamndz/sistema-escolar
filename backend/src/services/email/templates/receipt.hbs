<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <style>
      body { font-family: Arial, Helvetica, sans-serif; color: #1e293b; background: #f8fafc; padding: 24px; }
      .card { max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 24px; border: 1px solid #e2e8f0; }
      .header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
      .header img { height: 40px; }
      .header h1 { font-size: 18px; margin: 0; color: {{primaryColor}}; }
      .row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
      .row span:first-child { color: #64748b; }
      .amount { font-size: 24px; font-weight: bold; color: {{primaryColor}}; margin: 16px 0; text-align: center; }
      .footer { margin-top: 20px; font-size: 12px; color: #94a3b8; text-align: center; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="header">
        {{#if logoUrl}}<img src="{{logoUrl}}" alt="{{tenantName}}" />{{/if}}
        <h1>{{tenantName}}</h1>
      </div>
      <p>Estimado(a) <strong>{{guardianName}}</strong>, hemos recibido el pago correspondiente a:</p>
      <div class="row"><span>Alumno</span><span>{{studentName}}</span></div>
      <div class="row"><span>Concepto</span><span>{{periodLabel}}</span></div>
      <div class="row"><span>Fecha de pago</span><span>{{paidAt}}</span></div>
      <div class="amount">{{currency}} {{amount}}</div>
      <p>Adjuntamos el comprobante en PDF para tus registros.</p>
      <div class="footer">
        {{tenantName}} · {{contactEmail}} · {{contactPhone}}
      </div>
    </div>
  </body>
</html>
